	(text "Separate bus, CS, and interrupt lines from IMU 1 so a single bus or sensor fault cannot take out both IMUs."
		(exclude_from_sim no)
		(at 238.76 205.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1091d00d-02b5-415c-a0a3-a3457a2d60ca")
	)
	(text "INT2/FSYNC/CLKIN on PA8 (TIM1_CH1 / MCO1) so a 32 kHz CLKIN can be added in firmware later."
		(exclude_from_sim no)
		(at 117.856 209.042 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "25992825-961d-420f-8428-bb4adfee7816")
	)
	(text "IMU 1: ICM-42688-P on SPI1 (24 MHz max). RESV pin 7 must be GND, 2/3/10/11 tied to GND."
		(exclude_from_sim no)
		(at 117.856 206.502 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "674a05aa-64d4-407e-8223-50bafb50fa3a")
	)
	(text "IMU 2: BMI088 on SPI2 (10 MHz max). PS=GND selects SPI. NC pin 2 tied to GND per Bosch reference."
		(exclude_from_sim no)
		(at 238.76 203.2 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "b0f5c73b-c25d-47be-8eb7-053cbdae392c")
	)
	(text "MCU decoupling: one 100 nF per VDD/VBAT pin, 100 nF + 1 uF on VDDA and on VREF+. Place each cap at its pin."
		(exclude_from_sim no)
		(at 45.72 15.24 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "dba548c0-9ad3-4a2f-a470-3dfd22d5e0bc")
	)
	(text "ADC anti-alias RCs (R6/R7/C25, R8/C26): place C25 and C26 at the MCU ADC pins (PC0, PC1)."
